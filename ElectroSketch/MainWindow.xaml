<Window x:Class="ElectroSketch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ElectroSketch.Controls"
        Title="ElectroSketch" Width="1180" Height="760" MinWidth="720" MinHeight="540"
        Background="#F3F5F7" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel" Closing="Window_Closing" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" SizeChanged="Window_SizeChanged"
        SizeToContent="Manual" ShowInTaskbar="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2A323B" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#404A54" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9D0D7" />
            <Setter Property="Background" Value="#252C33" />
            <Setter Property="BorderBrush" Value="#444D56" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#4E6AF3" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#7588F6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#8D99A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#F8F9FA" />
        </Style>
        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#73808C" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F262D" BorderBrush="#151A1F" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderBrandColumn" Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="BrandPanel" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ELECTROSKETCH" Foreground="White" FontWeight="Bold" FontSize="17" />
                    <TextBlock Text="visual electronics lab · v0.8.5" Foreground="#8E9AA5" FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Click="New_Click" ToolTip="New topology">New</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Open_Click" ToolTip="Open a saved .ets topology">Open</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="Save_Click" ToolTip="Save (Ctrl+S)">Save</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="SaveAs_Click" ToolTip="Save as (Ctrl+Shift+S)">Save as</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ToggleNotes_Click" ToolTip="Open global notes">Notes</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ToggleConnectionGuide_Click" ToolTip="Show or hide the guide for the last selected object">Connections</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ToggleComponents_Click" ToolTip="Show or hide the Components panel">Components</Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="ToggleMeter_Click" ToolTip="Show or hide the Multimeter panel">Meter</Button>
                </StackPanel>
                <Border Grid.Column="2" Width="1" Height="30" Margin="13,0" Background="#3A434C" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SelectModeButton" GroupName="Mode" Tag="Select" Style="{StaticResource ModeButton}" IsChecked="True" Checked="Mode_Checked">↖  Select</RadioButton>
                    <RadioButton x:Name="WireModeButton" GroupName="Mode" Tag="Wire" Style="{StaticResource ModeButton}" Checked="Mode_Checked">⌁  Wire</RadioButton>
                    <RadioButton x:Name="MeterModeButton" GroupName="Mode" Tag="Probe" Style="{StaticResource ModeButton}" Checked="Mode_Checked">⌁  Meter probes</RadioButton>
                    <StackPanel x:Name="DrawingToolsPanel" Orientation="Horizontal">
                        <RadioButton GroupName="Mode" Tag="AnnotationText" Style="{StaticResource ModeButton}" Checked="Mode_Checked" ToolTip="Place words on the playground">T</RadioButton>
                        <RadioButton GroupName="Mode" Tag="DrawLine" Style="{StaticResource ModeButton}" Checked="Mode_Checked" ToolTip="Draw a line">╱</RadioButton>
                        <RadioButton GroupName="Mode" Tag="DrawArrow" Style="{StaticResource ModeButton}" Checked="Mode_Checked" ToolTip="Draw an arrow">➜</RadioButton>
                    </StackPanel>
                    <ComboBox x:Name="AnnotationColorComboBox" Width="108" Height="30" Margin="5,0,0,0" Padding="4,2"
                              SelectionChanged="AnnotationColorComboBox_SelectionChanged" ToolTip="Text color (independent of wire color)">
                        <ComboBoxItem Tag="#34495E" IsSelected="True">Text · dark</ComboBoxItem>
                        <ComboBoxItem Tag="#C62828">Text · red</ComboBoxItem>
                        <ComboBoxItem Tag="#1565C0">Text · blue</ComboBoxItem>
                        <ComboBoxItem Tag="#2E7D32">Text · green</ComboBoxItem>
                        <ComboBoxItem Tag="#6A1B9A">Text · purple</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="ZoomPanel" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" Foreground="#9DA8B2" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <Slider x:Name="ZoomSlider" Minimum="0.55" Maximum="1.35" Value="0.85" Width="105" TickFrequency="0.1" ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomText" Text="85%" Foreground="White" Width="42" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PaletteColumn" Width="230" MinWidth="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="MeterColumn" Width="326" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PalettePanel" Grid.Column="0" Background="White" BorderBrush="#DDE2E6" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,18">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Click="CloseComponents_Click" Padding="7,3" ToolTip="Close Components panel">✕</Button>
                            <TextBlock Text="COMPONENTS" FontSize="13" FontWeight="Bold" Foreground="#34404B" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource TinyLabel}" Text="CONTROLLERS &amp; POWER" Margin="2,0,0,10" />
                        <Button Style="{StaticResource PaletteButton}" Tag="ArduinoHeader" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="▣  Arduino connectors" FontWeight="SemiBold" /><TextBlock Text="5 V, GND and D2–D7" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" Tag="AcSource" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="∿  Simulated AC source" FontWeight="SemiBold" /><TextBlock Text="5 V RMS · 50 Hz" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="PLAYGROUND TOOLS" Margin="2,12,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <RadioButton GroupName="Mode" Tag="AnnotationText" Style="{StaticResource ModeButton}" Checked="Mode_Checked" Margin="0,0,5,5">T  Text</RadioButton>
                            <RadioButton GroupName="Mode" Tag="DrawLine" Style="{StaticResource ModeButton}" Checked="Mode_Checked" Margin="0,0,5,5">╱  Line</RadioButton>
                            <RadioButton GroupName="Mode" Tag="DrawArrow" Style="{StaticResource ModeButton}" Checked="Mode_Checked" Margin="0,0,5,5">➜  Arrow</RadioButton>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="POWER DISTRIBUTION" Margin="2,12,0,10" />
                        <Button Style="{StaticResource PaletteButton}" Tag="WallPlug" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="⌁  Türkiye wall outlet" FontWeight="SemiBold" /><TextBlock Text="230 V RMS · 50 Hz · L, N, PE" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" Tag="PowerStrip3" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="▭  3-socket power strip" FontWeight="SemiBold" /><TextBlock Text="Common L, N and PE rails" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" Tag="PowerStrip6" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="▭  6-socket power strip" FontWeight="SemiBold" /><TextBlock Text="Common L, N and PE rails" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="AC TO DC ADAPTERS" Margin="2,12,0,8" />
                        <ComboBox x:Name="AdapterCombo" SelectedIndex="0">
                            <ComboBoxItem Tag="Adapter5V2AUsbA">5 V 2 A · USB-A female</ComboBoxItem>
                            <ComboBoxItem Tag="Adapter5V2AUsbC">5 V 2 A · USB-C female</ComboBoxItem>
                            <ComboBoxItem Tag="AdapterFast18WUsbA">18 W fast charge · USB-A</ComboBoxItem>
                            <ComboBoxItem Tag="AdapterFast20WUsbC">20 W USB-C PD</ComboBoxItem>
                            <ComboBoxItem Tag="AdapterFast65WUsbC">65 W USB-C PD</ComboBoxItem>
                        </ComboBox>
                        <Button Click="AddAdapter_Click" Margin="0,7,0,14">Add power adapter</Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="PROTOTYPING" Margin="2,12,0,10" />
                        <Button Style="{StaticResource PaletteButton}" Tag="Breadboard" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="▦  Mini breadboard" FontWeight="SemiBold" /><TextBlock Text="12 rows + four rails" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="COMPONENTS" Margin="2,12,0,10" />
                        <Button Style="{StaticResource PaletteButton}" Tag="Led" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="●  Red LED" FontWeight="SemiBold" /><TextBlock Text="Anode and cathode" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaletteButton}" Tag="Resistor" Click="AddComponent_Click">
                            <StackPanel><TextBlock Text="—  Resistor" FontWeight="SemiBold" /><TextBlock Text="Default: 220 Ω" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel>
                        </Button>

                        <Border Background="#F0E6F7" CornerRadius="8" Padding="9" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="AUDIO" Margin="2,0,0,8" />
                                <Button Style="{StaticResource PaletteButton}" Tag="Speaker4Ohm2W" Click="AddComponent_Click"><StackPanel><TextBlock Text="◉  4 Ω 2 W speaker" FontWeight="SemiBold" /><TextBlock Text="Passive speaker load" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel></Button>
                                <Button Style="{StaticResource PaletteButton}" Tag="MihawkDriver" Click="AddComponent_Click" Margin="0"><StackPanel><TextBlock Text="◉  Mihawk headphone driver" FontWeight="SemiBold" /><TextBlock Text="50 mm neodymium · 32 Ω ±5" Foreground="#77838D" FontSize="11" Margin="22,3,0,0" /></StackPanel></Button>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,9,0,16" />
                        <TextBlock Style="{StaticResource TinyLabel}" Text="USB 2.0 CONNECTORS" Margin="2,0,0,8" />
                        <ComboBox x:Name="Usb2ConnectorCombo" SelectedIndex="0">
                            <ComboBoxItem Tag="UsbA2">Type-A female breakout · socket + solder</ComboBoxItem>
                            <ComboBoxItem Tag="UsbB2">Type-B 2.0 · 4 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMiniA">Mini-A · 5 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMiniB">Mini-B · 5 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMiniAb">Mini-AB receptacle · 5 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMicroA">Micro-A · 5 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMicroB">Micro-B · 5 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMicroAb">Micro-AB receptacle · 5 pins</ComboBoxItem>
                        </ComboBox>
                        <Button Click="AddUsb2Connector_Click" Margin="0,7,0,14">Add USB 2.0 connector</Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="SUPERSPEED &amp; USB-C" Margin="2,0,0,8" />
                        <ComboBox x:Name="Usb3ConnectorCombo" SelectedIndex="0">
                            <ComboBoxItem Tag="UsbA3">Type-A SuperSpeed · 9 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbB3">Type-B SuperSpeed · 9 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMicroA3">Micro-A SuperSpeed · 10 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMicroB3">Micro-B SuperSpeed · 10 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbMicroAb3">Micro-AB SuperSpeed · 10 pins</ComboBoxItem>
                            <ComboBoxItem Tag="UsbCPlug">Type-C plug · 22 contacts</ComboBoxItem>
                            <ComboBoxItem Tag="UsbCReceptacle">Type-C receptacle · 24 contacts</ComboBoxItem>
                        </ComboBox>
                        <Button Click="AddUsb3Connector_Click" Margin="0,7,0,14">Add SuperSpeed / USB-C</Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="LIGHTNING CONNECTORS" Margin="2,0,0,8" />
                        <ComboBox x:Name="LightningConnectorCombo" SelectedIndex="0">
                            <ComboBoxItem Tag="LightningPlug">Lightning plug · 8 contacts</ComboBoxItem>
                            <ComboBoxItem Tag="LightningReceptacle">Lightning receptacle · 8 contacts</ComboBoxItem>
                        </ComboBox>
                        <Button Click="AddLightningConnector_Click" Margin="0,7,0,14">Add Lightning connector</Button>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="ETHERNET" Margin="2,0,0,8" />
                        <ComboBox x:Name="EthernetCombo" SelectedIndex="0">
                            <ComboBoxItem Tag="Rj45Plug">RJ45 plug · 8 pins</ComboBoxItem>
                            <ComboBoxItem Tag="Rj45Jack">RJ45 female jack · 8 pins</ComboBoxItem>
                            <ComboBoxItem Tag="EthernetCat5">Cat5 cable</ComboBoxItem>
                            <ComboBoxItem Tag="EthernetCat5e">Cat5e cable</ComboBoxItem>
                            <ComboBoxItem Tag="EthernetCat6">Cat6 cable</ComboBoxItem>
                            <ComboBoxItem Tag="EthernetCat6a">Cat6A cable</ComboBoxItem>
                            <ComboBoxItem Tag="EthernetCat7">Cat7 cable</ComboBoxItem>
                            <ComboBoxItem Tag="EthernetCat8">Cat8 cable</ComboBoxItem>
                        </ComboBox>
                        <Button Click="AddEthernet_Click" Margin="0,7,0,14">Add Ethernet object</Button>

                        <Border Background="#E8F5EE" CornerRadius="8" Padding="9" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="READY-TO-USE CABLES" Margin="2,0,0,8" />
                                <ComboBox x:Name="ReadyCableCombo" SelectedIndex="0">
                                    <ComboBoxItem Tag="UsbAToLightningCable">USB-A to Lightning</ComboBoxItem>
                                    <ComboBoxItem Tag="UsbCToUsbCCable">USB-C to USB-C</ComboBoxItem>
                                    <ComboBoxItem Tag="UsbAToUsbACable">USB-A to USB-A</ComboBoxItem>
                                    <ComboBoxItem Tag="UsbBToUsbBCable">USB-B to USB-B</ComboBoxItem>
                                    <ComboBoxItem Tag="UsbAToUsbBCable">USB-A to USB-B</ComboBoxItem>
                                    <ComboBoxItem Tag="UsbAToUsbCCable">USB-A to USB-C</ComboBoxItem>
                                    <ComboBoxItem Tag="UsbCToLightningCable">USB-C to Lightning</ComboBoxItem>
                                </ComboBox>
                                <Button Click="AddReadyCable_Click" Margin="0,7,0,0">Add ready cable</Button>
                            </StackPanel>
                        </Border>

                        <Border Background="#E8F2FA" CornerRadius="8" Padding="9" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TinyLabel}" Text="RECHARGEABLE DEVICES" Margin="2,0,0,8" />
                                <ComboBox x:Name="DeviceCombo" SelectedIndex="0">
                                    <ComboBoxItem Tag="DeviceUsbA">USB-A rechargeable light</ComboBoxItem>
                                    <ComboBoxItem Tag="DeviceUsbB">USB-B rechargeable gadget</ComboBoxItem>
                                    <ComboBoxItem Tag="DeviceUsbC">USB-C rechargeable device</ComboBoxItem>
                                    <ComboBoxItem Tag="DeviceLightning">Lightning rechargeable device</ComboBoxItem>
                                </ComboBox>
                                <Button Click="AddDevice_Click" Margin="0,7,0,0">Add rechargeable device</Button>
                            </StackPanel>
                        </Border>

                        <Border Background="#F1F4F8" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="QUICK START" Style="{StaticResource TinyLabel}" Margin="0,0,0,7" />
                                <TextBlock Text="1. Choose Wire mode.&#x0a;2. Click two round pins.&#x0a;3. Drag empty canvas to pan.&#x0a;4. Mouse wheel zooms."
                                           Foreground="#52606B" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Tip: the top-right symbol on USB, Lightning, adapter and Ethernet parts switches between physical and electronics views."
                                   Foreground="#7A858F" FontSize="11" TextWrapping="Wrap" Margin="3,14,3,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="PaletteV2Panel" Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="0,0,1,0">
                <Grid Margin="13,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Click="CloseComponents_Click" Padding="7,3" ToolTip="Close Components panel">✕</Button>
                        <StackPanel>
                            <TextBlock Text="COMPONENTS" FontSize="13" FontWeight="Bold" Foreground="#34404B" />
                            <TextBlock x:Name="PaletteCountText" Text="0 items" Foreground="#7B8791" FontSize="10" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="PaletteSearchBox" Padding="8,6" FontSize="12" ToolTip="Search parts by name, category, or connection type"
                                 TextChanged="PaletteSearchBox_TextChanged" />
                        <ComboBox x:Name="PaletteCategoryCombo" Margin="0,7,0,0" Padding="6,4"
                                  SelectionChanged="PaletteCategoryCombo_SelectionChanged" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Double-click or select and add · drag onto the playground" Foreground="#74818B"
                               FontSize="10" TextWrapping="Wrap" Margin="1,0,0,8" />
                    <ListBox x:Name="ComponentList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ComponentList_SelectionChanged" MouseDoubleClick="ComponentList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="ComponentList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ComponentList_PreviewMouseMove">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Tint}" BorderBrush="#DDE4E8" BorderThickness="1" CornerRadius="8" Padding="9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#29343D" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="#66747F" Margin="0,3,0,1" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#75818A" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="4" Background="#F4F6F8" CornerRadius="7" Padding="9" Margin="0,8,0,8">
                        <TextBlock x:Name="PaletteDetailText" Text="Choose an item to see its contacts and connection behavior."
                                   FontSize="10" Foreground="#52606B" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="PaletteAddButton" Grid.Row="5" Click="PaletteAddSelected_Click" IsEnabled="False"
                            Background="#4E6AF3" Foreground="White" BorderBrush="#4058D3" Padding="9,8" FontWeight="SemiBold">
                        Add selected to playground
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#E9EDF0" Padding="10">
                <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F8F9FA"
                              PreviewMouseDown="CanvasScrollViewer_PreviewMouseDown" PreviewMouseMove="CanvasScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="CanvasScrollViewer_PreviewMouseUp" ScrollChanged="CanvasScrollViewer_ScrollChanged">
                    <Grid x:Name="CanvasScaleHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="0.85" ScaleY="0.85" />
                        </Grid.LayoutTransform>
                        <controls:CircuitCanvas x:Name="CircuitSurface" AllowDrop="True" DragOver="Canvas_DragOver" Drop="Canvas_Drop" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border x:Name="WireOptionsPanel" Grid.Column="1" Panel.ZIndex="25" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="18,10,0,0" Padding="10,8" Background="#FDFEFE" BorderBrush="#BFC8D0" BorderThickness="1"
                    CornerRadius="8" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Border x:Name="CurrentWireColorSwatch" DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="7" Background="#20262D" Margin="0,0,7,0" />
                        <TextBlock x:Name="CurrentWireColorText" Text="Black · key 1" FontSize="11" FontWeight="SemiBold" Foreground="#45515B" />
                    </DockPanel>
                    <UniformGrid Columns="3" Rows="3" Width="120">
                        <Button Tag="1" Click="WireColorButton_Click" Background="#20262D" Foreground="White" Padding="8,4" Margin="2" ToolTip="1 · Black">1</Button>
                        <Button Tag="2" Click="WireColorButton_Click" Background="#E53935" Foreground="White" Padding="8,4" Margin="2" ToolTip="2 · Red">2</Button>
                        <Button Tag="3" Click="WireColorButton_Click" Background="#27AE60" Foreground="White" Padding="8,4" Margin="2" ToolTip="3 · USB D+ green">3</Button>
                        <Button Tag="4" Click="WireColorButton_Click" Background="#F2F2F2" Foreground="#20262D" Padding="8,4" Margin="2" ToolTip="4 · USB D− white">4</Button>
                        <Button Tag="5" Click="WireColorButton_Click" Background="#F4A52C" Foreground="#20262D" Padding="8,4" Margin="2" ToolTip="5 · Orange (illustrative)">5</Button>
                        <Button Tag="6" Click="WireColorButton_Click" Background="#3285D5" Foreground="White" Padding="8,4" Margin="2" ToolTip="6 · Blue">6</Button>
                        <Button Tag="7" Click="WireColorButton_Click" Background="#F2C94C" Foreground="#20262D" Padding="8,4" Margin="2" ToolTip="7 · Yellow (illustrative)">7</Button>
                        <Button Tag="8" Click="WireColorButton_Click" Background="#8E44AD" Foreground="White" Padding="8,4" Margin="2" ToolTip="8 · Purple (illustrative)">8</Button>
                        <Button Tag="9" Click="WireColorButton_Click" Background="#8B5A2B" Foreground="White" Padding="8,4" Margin="2" ToolTip="9 · AC live brown">9</Button>
                    </UniformGrid>
                    <TextBlock Text="Keys 1–4 follow USB 2.0 colors. Other USB-C wire colors vary by cable maker."
                               Foreground="#61707A" FontSize="10" TextWrapping="Wrap" Width="150" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="MeterPanel" Grid.Column="2" Background="#F8F9FA" BorderBrush="#DDE2E6" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Click="CloseMeter_Click" Padding="7,3" ToolTip="Close Multimeter panel">✕</Button>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="DIGITAL MULTIMETER" FontSize="12" FontWeight="Bold" Foreground="#34404B" />
                                    <TextBlock Text="SIMULATED MULTIMETER · AC RMS" FontSize="9" Foreground="#83909B" />
                            </StackPanel>
                            <Ellipse Width="9" Height="9" Fill="#35C46A" HorizontalAlignment="Right" Margin="0,4,2,0" VerticalAlignment="Top" />
                        </DockPanel>

                        <Border Background="#20272C" BorderBrush="#0E1215" BorderThickness="2" CornerRadius="9" Padding="15,12" MinHeight="112">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="MeterDisplay" Text="5.000" Foreground="#D7F0BE" FontFamily="Consolas" FontSize="39" FontWeight="Bold" />
                                    <TextBlock x:Name="MeterUnit" Text=" V DC" Foreground="#AFC99B" FontFamily="Consolas" FontSize="13" VerticalAlignment="Bottom" Margin="5,0,0,8" />
                                </StackPanel>
                                <TextBlock x:Name="MeterDetail" Grid.Row="1" Text="Ready" Foreground="#9EABA6" FontSize="10" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource TinyLabel}" Text="MEASUREMENT" Margin="1,16,0,7" />
                        <ComboBox x:Name="MeterProfileCombo" SelectionChanged="MeterProfileCombo_SelectionChanged" SelectedIndex="0" Margin="0,0,0,7">
                            <ComboBoxItem Tag="AutoRange">ElectroSketch auto-range meter</ComboBoxItem>
                            <ComboBoxItem Tag="Mas830L">Wellhise MAS830L manual meter</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="MeterModeCombo" SelectionChanged="MeterModeCombo_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Tag="DcVoltage">V⎓  DC voltage</ComboBoxItem>
                            <ComboBoxItem Tag="AcVoltage">V∿  AC voltage (RMS)</ComboBoxItem>
                            <ComboBoxItem Tag="DcCurrent">A⎓  DC current</ComboBoxItem>
                            <ComboBoxItem Tag="Continuity">)))  Continuity</ComboBoxItem>
                            <ComboBoxItem Tag="Resistance">Ω  Resistance</ComboBoxItem>
                            <ComboBoxItem Tag="Diode">▷|  Diode test</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="MeterRangeCombo" SelectionChanged="MeterRangeCombo_SelectionChanged" Margin="0,7,0,0" Visibility="Collapsed" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="13" Height="13" Fill="#20262D" Stroke="#000" StrokeThickness="1" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BLACK · COM" FontSize="10" FontWeight="Bold" Foreground="#4E5962" />
                                <TextBlock x:Name="BlackProbeLabel" Text="Not connected" FontSize="11" Foreground="#7A858E" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="ArmBlackProbe_Click" Padding="7,5" FontSize="11">Place</Button>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="13" Height="13" Fill="#E53935" Stroke="#A7201D" StrokeThickness="1" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RED · VΩ" FontSize="10" FontWeight="Bold" Foreground="#4E5962" />
                                <TextBlock x:Name="RedProbeLabel" Text="Not connected" FontSize="11" Foreground="#7A858E" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="ArmRedProbe_Click" Padding="7,5" FontSize="11">Place</Button>
                        </Grid>
                        <Separator Margin="0,20,0,16" />
                        <TextBlock Style="{StaticResource TinyLabel}" Text="CIRCUIT STATUS" Margin="1,0,0,8" />
                        <Border x:Name="HealthBorder" Background="#EDF7F0" BorderBrush="#CEE8D5" BorderThickness="1" CornerRadius="8" Padding="11">
                            <TextBlock x:Name="HealthText" Text="Circuit ready." Foreground="#3F6750" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                        </Border>

                        <Border x:Name="SafetyBorder" Background="#FFE9E6" BorderBrush="#D75B50" BorderThickness="2" CornerRadius="8" Padding="11" Margin="0,13,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SafetyTitle" Text="SAFETY LOCK" FontWeight="Bold" Foreground="#9B211A" />
                                <TextBlock x:Name="SafetyText" TextWrapping="Wrap" Foreground="#6E2B27" Margin="0,5,0,8" />
                                <Button Click="ResetSafety_Click">I understand — unlock playground</Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ConnectionGuideDrawer" Grid.Column="1" Grid.ColumnSpan="2" Panel.ZIndex="39" Width="440"
                    HorizontalAlignment="Right" Background="#FCFDFE" BorderBrush="#CCD3DA" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <DockPanel Margin="16">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Click="CloseConnectionGuide_Click" Padding="7,3" ToolTip="Close connection guide">✕</Button>
                        <TextBlock Text="CONNECTION GUIDE" FontSize="13" FontWeight="Bold" Foreground="#34404B" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ConnectionGuideText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                   Foreground="#35424C" LineHeight="18" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="NotesDrawer" Grid.Column="1" Grid.ColumnSpan="2" Panel.ZIndex="40" Width="390"
                    HorizontalAlignment="Right" Background="#FCFDFE" BorderBrush="#CCD3DA" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Click="CloseNotes_Click" Padding="8,4" ToolTip="Close notes">✕</Button>
                        <StackPanel>
                            <TextBlock Text="PROJECT NOTES" FontWeight="Bold" FontSize="15" Foreground="#27323B" />
                            <TextBlock Text="Global — stays the same for every .ets file" FontSize="10" Foreground="#7B8791" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="NotesTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="9" TextChanged="NotesTextBox_TextChanged"
                             ToolTip="These notes are saved automatically" />
                    <DockPanel Grid.Row="2" Margin="0,12,0,9">
                        <Button DockPanel.Dock="Right" Click="LoadNoteImages_Click" Padding="10,6">Add images…</Button>
                        <TextBlock Text="IMAGES" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotesImagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#DDE2E6" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="8">
                                        <StackPanel>
                                            <Image Source="{Binding Path}" MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Center" />
                                            <DockPanel Margin="2,7,2,0">
                                                <Button DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveNoteImage_Click" Padding="7,3" FontSize="10">Remove</Button>
                                                <TextBlock Text="{Binding Name}" Foreground="#68747D" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusText" Text="Starter circuit loaded — the LED is powered through a 220 Ω resistor." Foreground="#5F6B75" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="DocumentText" Text="LED starter circuit" Foreground="#8A949D" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
